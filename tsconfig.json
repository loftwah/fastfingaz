{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    ".wxt/types/**/*.d.ts",
    "entrypoints",
    "content",
    "shared",
    "types",
    "tests",
    "demo",
    "wxt.config.ts"
  ]
}
