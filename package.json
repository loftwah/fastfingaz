{
  "name": "thinktype",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "A Chrome extension that measures your real typing speed while you think out loud with ChatGPT.",
  "author": "Dean Lofts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loftwah/thinktype.git"
  },
  "homepage": "https://github.com/loftwah/thinktype#readme",
  "bugs": {
    "url": "https://github.com/loftwah/thinktype/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "postinstall": "wxt prepare",
    "unpacked": "node scripts/copy-unpacked.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "site:build": "node scripts/build-site.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "site:deploy": "npm run site:build && npx wrangler pages deploy site/dist --project-name thinktype --branch main",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run test && npm run build",
    "zip": "wxt zip"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.332",
    "@types/node": "^26.6.6",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^3.2.7",
    "wxt": "^0.21.5"
  }
}
