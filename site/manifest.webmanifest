{
  "name": "Thinktype — measure the speed of a thought",
  "short_name": "Thinktype",
  "description": "A local-only Chrome extension that measures how fast you turn a thought into text in ChatGPT.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f2efe6",
  "theme_color": "#f2efe6",
  "icons": [
    {
      "src": "/icon-128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
